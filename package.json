{
  "name": "vinlook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "npm run dev --workspace=@vinlook/web",
    "build": "npm run build --workspaces --if-present",
    "check:scaffold": "node scripts/check-scaffold.mjs"
  }
}
