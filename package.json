{
  "name": "vinlook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "npm run dev --workspace=@vinlook/web",
    "build": "npm run build --workspaces --if-present",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "test:runtime": "node --test tests/runtime-health.test.mjs",
    "test:identity": "node --test services/identity/test/schemas.test.js",
    "test:identity:db": "node --test services/identity/test/indexes.integration.test.js",
    "test:auth": "node --test services/identity/test/auth.test.js",
    "test:auth:db": "node --test services/identity/test/auth.integration.test.js",
    "test:authorization": "node --test tests/authorization.test.mjs",
    "test:authorization:db": "node --test services/identity/test/authorization.integration.test.js",
    "test:sessions:db": "node --test services/identity/test/session.integration.test.js",
    "test:audit:db": "node --test services/identity/test/audit.integration.test.js"
  }
}
