# Copy to .env.cloud (ignored). Use Supabase SESSION pooler, port 5432, and URL-encode the password.
DATABASE_URL=
SUPABASE_URL=https://vydvpkqjlmgpoumvknlr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vinlook-media
# Generated during verified import. Do not replace this ID on later deploys.
VINLOOK_DATASET_ID=
ADMIN_API_KEY=
BACKUP_ENCRYPTION_KEY=
# Server-side only (never exposed to FE). Required on Render to display vinlook-api CPU/RAM in Admin Monitor.
# Render automatically sets RENDER_SERVICE_ID at runtime; set it manually for local/staging checks.
RENDER_API_KEY=
RENDER_SERVICE_ID=
TRANSLATION_PROVIDERS=mymemory
NODE_ENV=production
