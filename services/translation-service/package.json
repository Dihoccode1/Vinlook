{
  "name": "@tourism/translation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audio:export-files": "tsx --env-file=../../.env src/export-narration-files.ts",
    "content:complete-translations": "tsx --env-file=../../.env src/import-remaining-translations.ts",
    "content:import-editorial": "tsx --env-file=../../.env src/import-editorial.ts",
    "content:prepare": "tsx --env-file=../../.env src/prepare-content.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "db:migrate": "tsx --env-file=../../.env src/database.ts",
    "test:integration": "tsx --env-file=../../.env --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mssql": "^12.7.13",
    "zod": "^4.6.7"
  }
}
