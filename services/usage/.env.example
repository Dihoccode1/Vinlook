NODE_ENV=development
HOST=127.0.0.1
PORT=3003

# Required when a protected route initializes its authorization adapter.
IDENTITY_BASE_URL=REPLACE_WITH_EXACT_IDENTITY_ORIGIN
USAGE_IDENTITY_SERVICE_KEY_B64URL=REPLACE_WITH_OWN_CALLER_KEY

# Optional business runtime. Set all three only after the Usage catalog has been
# provisioned and verified under its separately approved environment plan.
# URI must select vinlook_usage; never reuse Identity/Content DB credentials.
# USAGE_MONGODB_URI=REPLACE_WITH_PRIVATE_USAGE_URI
# CONTENT_BASE_URL=REPLACE_WITH_EXACT_CONTENT_ORIGIN
# USAGE_ALLOWED_ORIGINS=REPLACE_WITH_COMMA_SEPARATED_EXACT_HTTPS_ORIGINS
# Optional private Content jobs caller, distinct from the Identity caller key.
# USAGE_CONTENT_CALLER_KEY_B64URL=REPLACE_WITH_DEDICATED_CONTENT_CALLER_KEY
