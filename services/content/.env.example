NODE_ENV=development
HOST=127.0.0.1
PORT=3002

# Required when a protected route initializes its authorization adapter.
IDENTITY_BASE_URL=REPLACE_WITH_EXACT_IDENTITY_ORIGIN
CONTENT_IDENTITY_SERVICE_KEY_B64URL=REPLACE_WITH_OWN_CALLER_KEY

# Opt-in draft runtime; leave unset for health-only scaffold.
# Never commit an actual Mongo URI or service key.
# CONTENT_MONGODB_URI=REPLACE_WITH_CONTENT_OWNED_URI
# CONTENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional backend media configuration: all three or none; never commit real values.
# CLOUDINARY_CLOUD_NAME=REPLACE_WITH_OWN_CLOUD_NAME
# CLOUDINARY_API_KEY=REPLACE_WITH_BACKEND_KEY
# CLOUDINARY_API_SECRET=REPLACE_WITH_BACKEND_SECRET

# Optional dedicated canonical32-byte base64url key, distinct from Content Identity credential.
# Missing leaves TASK014 public endpoints unavailable; never commit a real value.
# CONTENT_PUBLIC_CURSOR_KEY_B64URL=

# Optional single local worker credential; configure all required fields together.
# No real secret/model manifest is configured by TASK016.
# CONTENT_WORKER_ID=
# CONTENT_WORKER_KEY_B64URL=
# Optional distinct old key with absolute ISO UTC cutoff (maximum24h).
# CONTENT_WORKER_OLD_KEY_B64URL=
# CONTENT_WORKER_OLD_KEY_EXPIRES_AT=

# TASK017 adapters: disabled by default. Enable only after separate real-project review.
CONTENT_GEMINI_ENABLED=false
# GEMINI_API_KEY=
# CONTENT_GEMINI_FREE_TIER_CONFIRMED_AT=
# CONTENT_GEMINI_TRANSLATION_RPM=
# CONTENT_GEMINI_TRANSLATION_RPD=
# CONTENT_GEMINI_TTS_RPM=
# CONTENT_GEMINI_TTS_RPD=
# CONTENT_FFMPEG_PATH=/usr/bin/ffmpeg
# CONTENT_FFPROBE_PATH=/usr/bin/ffprobe
# Optional internal jobs summary: must match USAGE_CONTENT_CALLER_KEY_B64URL privately.
# CONTENT_USAGE_CALLER_KEY_B64URL=REPLACE_WITH_DEDICATED_USAGE_CALLER_KEY
