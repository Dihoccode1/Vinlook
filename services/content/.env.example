NODE_ENV=development
HOST=127.0.0.1
PORT=3002

# Required when a protected route initializes its authorization adapter.
IDENTITY_BASE_URL=REPLACE_WITH_EXACT_IDENTITY_ORIGIN
CONTENT_IDENTITY_SERVICE_KEY_B64URL=REPLACE_WITH_OWN_CALLER_KEY

# Opt-in draft runtime; leave unset for health-only scaffold.
# Never commit an actual Mongo URI or service key.
# CONTENT_MONGODB_URI=REPLACE_WITH_CONTENT_OWNED_URI
# CONTENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional backend media configuration: all three or none; never commit real values.
# CLOUDINARY_CLOUD_NAME=REPLACE_WITH_OWN_CLOUD_NAME
# CLOUDINARY_API_KEY=REPLACE_WITH_BACKEND_KEY
# CLOUDINARY_API_SECRET=REPLACE_WITH_BACKEND_SECRET
