NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Invalid replacement markers: never commit real values.
IDENTITY_MONGODB_URI=REPLACE_WITH_IDENTITY_DB_URI
IDENTITY_JWT_KEY_B64URL=REPLACE_WITH_CANONICAL_RANDOM_KEY
IDENTITY_RATE_HMAC_KEY_B64URL=REPLACE_WITH_DIFFERENT_RANDOM_KEY
IDENTITY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IDENTITY_TRUST_PROXY_CIDRS=

IDENTITY_CONTENT_SERVICE_KEY_B64URL=REPLACE_WITH_RANDOM_CALLER_KEY
IDENTITY_USAGE_SERVICE_KEY_B64URL=REPLACE_WITH_DIFFERENT_CALLER_KEY
# Optional previous keys require an absolute UTC expiry, max24h overlap.
# IDENTITY_CONTENT_PREVIOUS_SERVICE_KEY_B64URL=REPLACE_WITH_OLD_CALLER_KEY
# IDENTITY_CONTENT_PREVIOUS_KEY_EXPIRES_AT=REPLACE_WITH_ABSOLUTE_UTC_EXPIRY
# IDENTITY_USAGE_PREVIOUS_SERVICE_KEY_B64URL=REPLACE_WITH_OLD_CALLER_KEY
# IDENTITY_USAGE_PREVIOUS_KEY_EXPIRES_AT=REPLACE_WITH_ABSOLUTE_UTC_EXPIRY
