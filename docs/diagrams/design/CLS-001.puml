@startuml
!pragma layout smetana
skinparam defaultFontName SansSerif
title CLS-001 — Identity responsibility view
footer APPROVED D-016 DEC-076 | UC-019, UC-020, UC-021, UC-022, UC-023, UC-024, UC-025, UC-026, UC-027, UC-028, UC-029

class "Identity & Staff API" as API {
 register()
 login()
 authorizeCurrent()
 manageSession()
 receiveAuditEvent()
 issueRecoveryCode()
}
class StaffAccount {
 id
 email
 passwordHash
 role
 status
 authVersion 
}
class WorkSession {
 id
 staffId
 workDateVN
 status 
}
class AuditLog {
 eventId
 actorType
 actorId
 operatorId
 workSessionId 
}
class RecoveryCode {
 codeHash
 expiresAt
 usedAt
 issuedBy
 issuedByOperator 
}
class AuthRateLimit {
 key
 count
 expiresAt 
}
StaffAccount "1" -- "0..*" WorkSession
WorkSession "0..1" -- "0..*" AuditLog
StaffAccount "1" -- "0..*" RecoveryCode
API ..> StaffAccount
API ..> WorkSession
API ..> AuditLog
API ..> RecoveryCode
API ..> AuthRateLimit
note bottom of API: Conceptual operations, not a required OO controller/repository pattern.

@enduml
