@startuml
!pragma layout smetana
skinparam defaultFontName SansSerif
title CLS-004 — Browser and routing responsibilities
footer APPROVED D-016 DEC-076 | UC-001, UC-002, UC-003, UC-004, UC-005, UC-006, UC-007, UC-008, UC-009, UC-010, UC-011

class "Visitor UI" as UI {
 showMapSearch()
 playAudio()
 selectDestination() 
}
class "Navigation coordinator" as Nav {
 checkFix()
 calculateCurrent()
 cancel()
 acceptCurrentResult() 
}
class "Routing Web Worker" as Engine {
 loadGraph()
 snap()
 astar()
 instructions() 
}
class "Offline package manager" as Offline {
 downloadVerify()
 activateCandidate()
 reopenActive() 
}
class "Browser storage" as Storage {
 packages
 packageFiles
 settings
 cachedShell 
}
UI ..> Nav
UI ..> Offline
Nav ..> Engine : versioned messages
Nav ..> Offline : compatible graph snapshot
Offline ..> Storage
note bottom of Engine: Proposed functional modules, no inheritance/framework/pattern imposed.

@enduml
