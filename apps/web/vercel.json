{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {"source":"/routing/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/:path*","headers":[{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ],
  "rewrites": [
    { "source": "/staff/:path*", "destination": "/index.html" }
  ]
}
