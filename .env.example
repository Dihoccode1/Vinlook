NODE_ENV=development
POI_PORT=4001
GATEWAY_PORT=4000
NAVIGATION_PORT=4002
NAVIGATION_SERVICE_URL=http://localhost:4002
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
POI_SERVICE_URL=http://localhost:4001
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=PoiDb
SQLSERVER_USER=sa
# Local development only. Replace this before sharing/deploying.
SQLSERVER_PASSWORD=YOUR_STRONG_SQL_PASSWORD
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERTIFICATE=true

TRANSLATION_PORT=4003
TRANSLATION_SERVICE_URL=http://localhost:4003
TRANSLATION_DATABASE=TranslationDb
# Backend only. Enable Cloud Translation API in your Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=

GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
TRANSLATION_PROVIDER=gemini
# If set, takes precedence over TRANSLATION_PROVIDER. Share work and fail over on errors.
TRANSLATION_PROVIDERS=gemini,mymemory
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite
# Optional narration delivery instructions; leave empty to use the tour guide preset.
GEMINI_TTS_STYLE=
TTS_PROVIDERS=gemini,azure,google
# Azure Speech resource: select Free F0 in Azure. Keys stay on the backend.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Enable Cloud Text-to-Speech API; this adapter uses Standard voices.
GOOGLE_TTS_API_KEY=


# Shared secret for local admin Vite proxy and POI admin API. Never use a VITE_ prefix.
ADMIN_API_KEY=

# Optional Photon-compatible search endpoint. Local app limits requests and caches results.
PHOTON_SEARCH_URL=https://photon.komoot.io/api/


# Admin login: scrypt salt:hash (16-byte salt and 64-byte derived key, hex); server-only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Public customer map origin used when generating downloadable QR images.
VITE_PUBLIC_WEB_URL=

# Docker server: http://localhost:8080 and /admin/.
WEB_PORT=8080
# Optional: token for a remotely managed Cloudflare Tunnel. Backend only.
CLOUDFLARE_TUNNEL_TOKEN=
